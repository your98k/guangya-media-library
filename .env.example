# 复制为 .env 后按需修改（docker compose 会自动读取）
PORT=8080
# 面板 worker 接口令牌：示例 worker 与任何外部自动化都必须带这个令牌
WORKER_TOKEN=change-me
# 示例 worker 可选：填了之后搜索请求走真实 TMDB
TMDB_API_KEY=

# ===== 真实 worker 骨架（worker/real）可选配置，默认全部关闭，需要时取消注释并填值 =====
# WORKER_POLL_SECONDS=15
# JIAOFU_COOKIE=
# MINI_COOKIE=
# GUANGYA_COOKIE=
# GUANGYA_SESSION_FILE=/path/to/guangya-session.json
# GUANGYA_INGEST=off
# GUANGYA_LIBRARY_MAP={"作品名":"Season文件夹ID"}
# GUANGYA_UNCLASSIFIED_FOLDER_ID=
# GUANGYA_CATEGORY_IDS={"电影":"","剧集":"","动漫":""}
# SOURCE_DELAY_MS=1500
# DRIVEMBY_TOKEN=
# DRIVEMBY_REFRESH_URL=https://drivemby.com/api/hooks/refresh
